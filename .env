# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY — DO NOT COMMIT TO GIT (already in .gitignore)
# Production values come from GitHub Actions Secrets injected into the server
# ─────────────────────────────────────────────────────────────────────────────

# Database — uses Docker service name "postgres" (see docker-compose.dev.yml)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rrf_portal

# JWT
JWT_SECRET=RRF_PORTAL_SECRET_KEY_2026
JWT_EXPIRES_IN=24h

# App
PORT=4000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000
