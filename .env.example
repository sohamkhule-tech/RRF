# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — RRF Portal
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env at the MONOREPO ROOT (same level as this file)
#   Backend reads .env via data-source.ts for migrations; runtime env vars
#   in Docker come directly from docker-compose.dev.yml environment: block.
#
# PRODUCTION (GitHub Actions):
#   All variables below must be set as GitHub Actions Secrets and injected
#   into the EC2 server (e.g. written to /etc/environment or pm2 ecosystem).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker:  DB_HOST=postgres  (Docker service name)
# Production:    DB_HOST=localhost  (if DB on same server) OR actual host
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=rrf_portal

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# ── Application ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
